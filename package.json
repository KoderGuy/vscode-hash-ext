{
  "name": "vscode-hash-ext",
  "displayName": "Hash & Transcode to Clipboard",
  "description": "Hash the selected text (15 algorithms incl. SHA-2/SHA-3/BLAKE2 + legacy SHA-1/MD5) or transcode it (Base64, Base64URL, URL, Hex, HTML entities) and copy the result to the clipboard. Every operation is its own bindable command. Works in VSCode, Cursor, and Antigravity.",
  "version": "0.0.1",
  "publisher": "KoderGuy",
  "repository": {
    "type": "git",
    "url": "https://github.com/koderguy/vscode-hash-ext.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "hash",
    "sha256",
    "sha3",
    "blake2",
    "md5",
    "base64",
    "clipboard",
    "transcode"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "hashToClipboard.pick",
        "category": "Hash & Transcode",
        "title": "Hash: Pick Algorithm → Clipboard"
      },
      {
        "command": "hashToClipboard.showCommand",
        "category": "Hash & Transcode",
        "title": "Show Command in Palette…"
      },
      {
        "command": "hashToClipboard.hideCommand",
        "category": "Hash & Transcode",
        "title": "Hide Command from Palette…"
      },
      {
        "command": "hashToClipboard.sha256",
        "category": "Hash & Transcode",
        "title": "Hash Selection: SHA-256 → Clipboard"
      },
      {
        "command": "hashToClipboard.sha384",
        "category": "Hash & Transcode",
        "title": "Hash Selection: SHA-384 → Clipboard"
      },
      {
        "command": "hashToClipboard.sha512",
        "category": "Hash & Transcode",
        "title": "Hash Selection: SHA-512 → Clipboard"
      },
      {
        "command": "hashToClipboard.sha512_256",
        "category": "Hash & Transcode",
        "title": "Hash Selection: SHA-512/256 → Clipboard"
      },
      {
        "command": "hashToClipboard.sha3_224",
        "category": "Hash & Transcode",
        "title": "Hash Selection: SHA3-224 → Clipboard"
      },
      {
        "command": "hashToClipboard.sha3_256",
        "category": "Hash & Transcode",
        "title": "Hash Selection: SHA3-256 → Clipboard"
      },
      {
        "command": "hashToClipboard.sha3_384",
        "category": "Hash & Transcode",
        "title": "Hash Selection: SHA3-384 → Clipboard"
      },
      {
        "command": "hashToClipboard.sha3_512",
        "category": "Hash & Transcode",
        "title": "Hash Selection: SHA3-512 → Clipboard"
      },
      {
        "command": "hashToClipboard.blake2b512",
        "category": "Hash & Transcode",
        "title": "Hash Selection: BLAKE2b-512 → Clipboard"
      },
      {
        "command": "hashToClipboard.blake2s256",
        "category": "Hash & Transcode",
        "title": "Hash Selection: BLAKE2s-256 → Clipboard"
      },
      {
        "command": "hashToClipboard.sha224",
        "category": "Hash & Transcode",
        "title": "Hash Selection: SHA-224 → Clipboard"
      },
      {
        "command": "hashToClipboard.sha512_224",
        "category": "Hash & Transcode",
        "title": "Hash Selection: SHA-512/224 → Clipboard"
      },
      {
        "command": "hashToClipboard.ripemd160",
        "category": "Hash & Transcode",
        "title": "Hash Selection: RIPEMD-160 → Clipboard"
      },
      {
        "command": "hashToClipboard.sha1",
        "category": "Hash & Transcode",
        "title": "Hash Selection: SHA-1 (insecure) → Clipboard"
      },
      {
        "command": "hashToClipboard.md5",
        "category": "Hash & Transcode",
        "title": "Hash Selection: MD5 (insecure) → Clipboard"
      },
      {
        "command": "transcode.pickEncode",
        "category": "Hash & Transcode",
        "title": "Encode: Pick Format → Clipboard"
      },
      {
        "command": "transcode.pickDecode",
        "category": "Hash & Transcode",
        "title": "Decode: Pick Format → Clipboard"
      },
      {
        "command": "transcode.base64Encode",
        "category": "Hash & Transcode",
        "title": "Encode: Base64 → Clipboard"
      },
      {
        "command": "transcode.base64Decode",
        "category": "Hash & Transcode",
        "title": "Decode: Base64 → Clipboard"
      },
      {
        "command": "transcode.base64urlEncode",
        "category": "Hash & Transcode",
        "title": "Encode: Base64URL → Clipboard"
      },
      {
        "command": "transcode.base64urlDecode",
        "category": "Hash & Transcode",
        "title": "Decode: Base64URL → Clipboard"
      },
      {
        "command": "transcode.urlEncode",
        "category": "Hash & Transcode",
        "title": "Encode: URL (percent) → Clipboard"
      },
      {
        "command": "transcode.urlDecode",
        "category": "Hash & Transcode",
        "title": "Decode: URL (percent) → Clipboard"
      },
      {
        "command": "transcode.hexEncode",
        "category": "Hash & Transcode",
        "title": "Encode: Hex → Clipboard"
      },
      {
        "command": "transcode.hexDecode",
        "category": "Hash & Transcode",
        "title": "Decode: Hex → Clipboard"
      },
      {
        "command": "transcode.htmlEncode",
        "category": "Hash & Transcode",
        "title": "Encode: HTML Entities → Clipboard"
      },
      {
        "command": "transcode.htmlDecode",
        "category": "Hash & Transcode",
        "title": "Decode: HTML Entities → Clipboard"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "hashToClipboard.sha256",
          "when": "hashExt.cmd.hashToClipboard_sha256"
        },
        {
          "command": "hashToClipboard.sha384",
          "when": "hashExt.cmd.hashToClipboard_sha384"
        },
        {
          "command": "hashToClipboard.sha512",
          "when": "hashExt.cmd.hashToClipboard_sha512"
        },
        {
          "command": "hashToClipboard.sha512_256",
          "when": "hashExt.cmd.hashToClipboard_sha512_256"
        },
        {
          "command": "hashToClipboard.sha3_224",
          "when": "hashExt.cmd.hashToClipboard_sha3_224"
        },
        {
          "command": "hashToClipboard.sha3_256",
          "when": "hashExt.cmd.hashToClipboard_sha3_256"
        },
        {
          "command": "hashToClipboard.sha3_384",
          "when": "hashExt.cmd.hashToClipboard_sha3_384"
        },
        {
          "command": "hashToClipboard.sha3_512",
          "when": "hashExt.cmd.hashToClipboard_sha3_512"
        },
        {
          "command": "hashToClipboard.blake2b512",
          "when": "hashExt.cmd.hashToClipboard_blake2b512"
        },
        {
          "command": "hashToClipboard.blake2s256",
          "when": "hashExt.cmd.hashToClipboard_blake2s256"
        },
        {
          "command": "hashToClipboard.sha224",
          "when": "hashExt.cmd.hashToClipboard_sha224"
        },
        {
          "command": "hashToClipboard.sha512_224",
          "when": "hashExt.cmd.hashToClipboard_sha512_224"
        },
        {
          "command": "hashToClipboard.ripemd160",
          "when": "hashExt.cmd.hashToClipboard_ripemd160"
        },
        {
          "command": "hashToClipboard.sha1",
          "when": "hashExt.cmd.hashToClipboard_sha1"
        },
        {
          "command": "hashToClipboard.md5",
          "when": "hashExt.cmd.hashToClipboard_md5"
        },
        {
          "command": "transcode.base64Encode",
          "when": "hashExt.cmd.transcode_base64Encode"
        },
        {
          "command": "transcode.base64Decode",
          "when": "hashExt.cmd.transcode_base64Decode"
        },
        {
          "command": "transcode.base64urlEncode",
          "when": "hashExt.cmd.transcode_base64urlEncode"
        },
        {
          "command": "transcode.base64urlDecode",
          "when": "hashExt.cmd.transcode_base64urlDecode"
        },
        {
          "command": "transcode.urlEncode",
          "when": "hashExt.cmd.transcode_urlEncode"
        },
        {
          "command": "transcode.urlDecode",
          "when": "hashExt.cmd.transcode_urlDecode"
        },
        {
          "command": "transcode.hexEncode",
          "when": "hashExt.cmd.transcode_hexEncode"
        },
        {
          "command": "transcode.hexDecode",
          "when": "hashExt.cmd.transcode_hexDecode"
        },
        {
          "command": "transcode.htmlEncode",
          "when": "hashExt.cmd.transcode_htmlEncode"
        },
        {
          "command": "transcode.htmlDecode",
          "when": "hashExt.cmd.transcode_htmlDecode"
        }
      ]
    },
    "configuration": {
      "title": "Hash & Transcode to Clipboard",
      "properties": {
        "hashToClipboard.encoding": {
          "type": "string",
          "enum": [
            "hex",
            "base64",
            "base64url"
          ],
          "default": "hex",
          "description": "Output encoding for hash digests (hex is the universal convention)."
        },
        "hashToClipboard.uppercase": {
          "type": "boolean",
          "default": false,
          "description": "Uppercase the digest (applies only to hex encoding)."
        },
        "hashToClipboard.showNotification": {
          "type": "boolean",
          "default": true,
          "description": "Show a confirmation notification after copying to the clipboard."
        },
        "hashToClipboard.multiSelection": {
          "type": "string",
          "enum": [
            "primary",
            "concatenate"
          ],
          "default": "primary",
          "enumDescriptions": [
            "Use only the primary (last-active) selection.",
            "Concatenate all non-empty selections in document order, joined by newlines."
          ],
          "description": "Behavior when there are multiple selections / cursors."
        },
        "hashToClipboard.visibleCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Command IDs shown in the Command Palette. Auto-recorded the first time you run a specific algorithm/codec (e.g. via a 'Pick' command). Edit/prune this list to control palette clutter; the 3 'Pick' commands are always shown and every command is keybindable regardless."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p ./",
    "build:extension": "node esbuild.mjs --extension",
    "watch": "node esbuild.mjs --watch",
    "build:qa": "node esbuild.mjs --qa",
    "qa:promote": "node qa/promote-qa.mjs",
    "qa:algorithms": "node -r ./qa/vscode-stub.cjs qa-dist/qa.pkg.mjs out/extension.js",
    "package": "node scripts/package-vsix.mjs",
    "release": "echo 'npm run check && npm run build:extension && npm run qa:algorithms && npm run package'",
    "build:certify": "npm run check && npm run build:extension && npm run qa:algorithms",
    "build:ext:pkg": "npm run package"
  },
  "devDependencies": {
    "@noble/hashes": "^2.2.0",
    "@types/node": "^22.1.1",
    "@types/vscode": "^1.107.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}